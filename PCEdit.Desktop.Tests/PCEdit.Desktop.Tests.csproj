<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xUnit v3 test projects are executables. This project alone is on v3: the Avalonia
         headless test package is built on it and cannot be mixed with xUnit 2. -->
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <!-- Same exclusion, for the same reason, as in PCEdit.Desktop.csproj: without it this
         project's build would import Avalonia's build-time telemetry task. -->
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- xunit.v3.mtp-off, not xunit.v3: the plain package brings in Microsoft.Testing.Platform
         and with it Microsoft.Testing.Extensions.Telemetry. Nothing here uses that platform
         (the tests run through xunit.runner.visualstudio), so it is left out of the graph
         altogether rather than switched off by an environment variable someone has to remember
         (issue #143). CI fails if any lock file names the telemetry package again. -->
    <PackageReference Include="xunit.v3.mtp-off" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PCEdit.Desktop\PCEdit.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\PCEdit.SaveFileHandler\mini-save.json" Link="TestData\mini-save.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
