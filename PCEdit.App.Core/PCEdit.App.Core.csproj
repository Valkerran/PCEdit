<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>PCEdit.App.Core</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- App-bundled data (friendly names keyed by id). Embedded so it loads identically from
             every UI head and the test host. Regenerate with the scripts under tools/item-catalog/. -->
        <None Remove="Data\ItemCatalog.json" />
        <EmbeddedResource Include="Data\ItemCatalog.json" />
        <None Remove="Data\LogisticsGroups.json" />
        <EmbeddedResource Include="Data\LogisticsGroups.json" />
        <InternalsVisibleTo Include="PCEdit.App.Core.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PCEdit.SaveFileHandler\PCEdit.SaveFileHandler.csproj" />
    </ItemGroup>

</Project>
