<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>PCEdit.Desktop</RootNamespace>
        <!-- Ship the executable / avares:// asset root as "PCEdit" (not "PCEdit.Desktop"). -->
        <AssemblyName>PCEdit</AssemblyName>
        <ApplicationManifest>app.manifest</ApplicationManifest>

        <!-- Version comes from <VersionPrefix> in the repo-root Directory.Build.props.
             The packaging scripts / Release workflow override it with -p:Version=<tag>. -->
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <RuntimeIdentifiers>linux-x64;win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
        <!-- All 15 UI-language satellites of PCEdit.App.Core must ship. -->
        <SatelliteResourceLanguages>en;en-GB;fr;de;es-ES;zh-Hans;ru;pl;pt-PT;ko;ja;pt-BR;it;zh-Hant;tr</SatelliteResourceLanguages>
    </PropertyGroup>

    <!--
        App-local ICU (Linux only).

        A self-contained publish does NOT bundle libicu - .NET dlopen()s the system one, and
        FailFasts at startup ("Couldn't find a valid ICU package installed on the system") on a
        distro that has none (openSUSE Tumbleweed ships without it). That made the AppImage,
        which promises to be self-contained, unlaunchable there. The `ldd | grep 'not found'`
        artifact check cannot catch it, because the load is a dlopen, not a link-time dependency.

        So the Linux publish carries its own ICU: the Microsoft.ICU.ICU4C.Runtime package drops
        libicu{uc,i18n,data}.so.$(AppLocalIcuVersion) next to the app, and the
        System.Globalization.AppLocalIcu switch tells the runtime to load those by that exact
        version suffix instead of probing the system. Keep the package version and the switch
        value identical - the switch IS the filename suffix.

        Windows (OS ICU since Win10 1703) and macOS (libicucore in the OS) need none of this, and
        the package has no osx RID, so this stays scoped to non-musl linux-* RIDs. A plain
        `dotnet build`/`dotnet test` with no RID is unaffected.

        Verified by the CI "AppImage ships app-local ICU" step and by deploy/build-appimage.sh,
        which both fail if the libraries or the switch go missing.
    -->
    <PropertyGroup>
        <AppLocalIcuVersion>72.1.0.3</AppLocalIcuVersion>
        <BundleAppLocalIcu Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('linux-')) and !$(RuntimeIdentifier.StartsWith('linux-musl'))">true</BundleAppLocalIcu>
    </PropertyGroup>

    <ItemGroup Condition="'$(BundleAppLocalIcu)' == 'true'">
        <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="$(AppLocalIcuVersion)" />
        <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="$(AppLocalIcuVersion)" Trim="false" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets/**" />
    </ItemGroup>

    <!--
        Build-time telemetry opt-out.

        Avalonia depends on Avalonia.BuildServices, whose .targets register an AvaloniaStatsTask
        that runs BeforeTargets="CoreCompile" on every non-design-time build and POSTs a build
        record (hashed project + machine name, an anonymous machine GUID, TFM, RID, Avalonia
        version, IDE, OS version/arch, CI detection) to avaloniaui.net. It is a build-time-only
        package - it ships tools/ and no lib/, so it never reached a published PCEdit - but it
        fires on every contributor's machine and every CI run, and PCEdit should not phone home
        to build any more than it does to run.

        Referencing the package directly with ExcludeAssets="all" wins over the transitive
        reference and drops its .targets from the generated obj/*.nuget.g.targets entirely, so
        the task is never registered. AVALONIA_TELEMETRY_OPTOUT=1 is the vendor's own switch, but
        it is per-machine and per-shell - it would not cover CI or a fresh clone.

        The version is pinned deliberately. When an Avalonia upgrade requires a newer
        Avalonia.BuildServices, restore fails with NU1605 (package downgrade) rather than quietly
        resolving back to a telemetry-enabled build: bump the version here to match and the guard
        in .github/workflows/ci.yml re-confirms the opt-out held.
    -->
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="Avalonia.BuildServices" Version="11.3.2" ExcludeAssets="all" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PCEdit.App.Core\PCEdit.App.Core.csproj" />
    </ItemGroup>

</Project>
