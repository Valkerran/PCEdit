<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PCEdit.App.Core.ViewModels;assembly=PCEdit.App.Core"
             xmlns:models="clr-namespace:PCEdit.App.Core.Models;assembly=PCEdit.App.Core"
             xmlns:m="using:PCEdit.Desktop.Markup"
             xmlns:conv="using:PCEdit.Desktop.Converters"
             x:Class="PCEdit.Desktop.Views.InventoriesView"
             x:DataType="vm:InventoriesViewModel"
             x:Name="Root">

    <UserControl.Styles>
        <!--
            A real save has hundreds of inventories. The outer list must virtualize, so it is a
            ListBox (default VirtualizingStackPanel) and is NOT wrapped in a ScrollViewer - a
            wrapping ScrollViewer gives it infinite height and defeats virtualization. Item chrome
            (selection/hover background, padding) is stripped so it reads as a plain card list.
        -->
        <Style Selector="ListBox.cards">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.cards ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="ListBox.cards ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.cards ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="RadioButton.chip">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!--
            Capacity badge states (issue #64). Colour comes from DynamicResource so it follows a
            live light/dark switch; every state also carries its own glyph and word, never colour
            alone. The selectors stop at the badge, so the tooltip popup keeps its own colours.
        -->
        <Style Selector="Border.badge.overFull">
            <Setter Property="BorderBrush" Value="{DynamicResource StatusWarningText}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.badge.overFull TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusWarningText}" />
        </Style>
        <Style Selector="Border.badge.overFull PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource StatusWarningText}" />
        </Style>
        <Style Selector="Border.badge.nearLoadLimit">
            <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorText}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.badge.nearLoadLimit TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusErrorText}" />
        </Style>
        <Style Selector="Border.badge.nearLoadLimit PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource StatusErrorText}" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- Even-odd fill ("F0") cuts the exclamation mark out of the shape. -->
        <StreamGeometry x:Key="OverFullGlyph">F0 M12,2 L23,21 L1,21 Z M11,9 L13,9 L13,15 L11,15 Z M11,17 L13,17 L13,19 L11,19 Z</StreamGeometry>
        <StreamGeometry x:Key="NearLoadLimitGlyph">F0 M7,1 L17,1 L23,7 L23,17 L17,23 L7,23 L1,17 L1,7 Z M11,6 L13,6 L13,14 L11,14 Z M11,16 L13,16 L13,18 L11,18 Z</StreamGeometry>
    </UserControl.Resources>

    <Panel>
        <DockPanel IsVisible="{Binding IsLoaded}" Margin="24">
            <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="headingRule" />
                    <TextBlock Text="{m:Loc Inventories_Heading}" Classes="h2" VerticalAlignment="Center" />
                </StackPanel>

                <TextBox Text="{Binding Query, Mode=TwoWay}"
                         PlaceholderText="{m:Loc Inventories_Search}"
                         AutomationProperties.Name="{m:Loc Inventories_SearchA11y}" />

                <StackPanel Orientation="Horizontal"
                            AutomationProperties.Name="{m:Loc Inventories_FilterA11y}">
                    <RadioButton Classes="chip" GroupName="invFilter" Content="{m:Loc Inventories_FilterAll}"
                                 IsChecked="{Binding Filter, Converter={StaticResource InvFilter}, ConverterParameter=All, Mode=TwoWay}" />
                    <RadioButton Classes="chip" GroupName="invFilter" Content="{m:Loc Inventories_FilterPlayers}"
                                 IsChecked="{Binding Filter, Converter={StaticResource InvFilter}, ConverterParameter=Players, Mode=TwoWay}" />
                    <RadioButton Classes="chip" GroupName="invFilter" Content="{m:Loc Inventories_FilterEquipment}"
                                 IsChecked="{Binding Filter, Converter={StaticResource InvFilter}, ConverterParameter=Equipment, Mode=TwoWay}" />
                    <RadioButton Classes="chip" GroupName="invFilter" Content="{m:Loc Inventories_FilterContainers}"
                                 IsChecked="{Binding Filter, Converter={StaticResource InvFilter}, ConverterParameter=Containers, Mode=TwoWay}" />
                    <!-- Only on a save with something flagged; the VM drops this filter when there is nothing to show. -->
                    <RadioButton Classes="chip" GroupName="invFilter"
                                 Content="{m:LocFormat Key=Inventories_FilterAttention, Path=AttentionCount}"
                                 IsVisible="{Binding AttentionCount, Converter={StaticResource CountIsPositive}}"
                                 IsChecked="{Binding Filter, Converter={StaticResource InvFilter}, ConverterParameter=NeedsAttention, Mode=TwoWay}" />
                </StackPanel>

                <ComboBox ItemsSource="{Binding WorldOptions}" SelectedItem="{Binding SelectedWorld}"
                          IsVisible="{Binding ShowWorldFilter}"
                          HorizontalAlignment="Left" MinWidth="200"
                          AutomationProperties.Name="{m:Loc Inventories_FilterWorldA11y}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:WorldFilterOption">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Text="{m:Loc Inventories_None}" Classes="caption"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding Groups.Count, Converter={StaticResource CountIsZero}}" />

            <TextBlock DockPanel.Dock="Top" Text="{m:Loc Inventories_NoMatch}" Classes="caption"
                       HorizontalAlignment="Center" Margin="0,8"
                       IsVisible="{Binding IsFilteredEmpty}" />

            <ListBox Classes="cards" ItemsSource="{Binding Groups}"
                     SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:InventoryGroup">
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="15"
                                                   TextTrimming="CharacterEllipsis" />
                                        <!-- The inventory id (issue #3). It reuses the fallback label's
                                             already-translated "Inventory #{0}" wording. -->
                                        <TextBlock Classes="caption"
                                                   Text="{m:LocFormat Key=Inv_Fallback, Path=InventoryId}"
                                                   IsVisible="{Binding ShowInventoryIdCaption}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="badge"
                                            Classes.overFull="{Binding IsOverFull}"
                                            Classes.nearLoadLimit="{Binding IsNearLoadLimit}"
                                            ToolTip.ServiceEnabled="{Binding NeedsAttention}">
                                        <ToolTip.Tip>
                                            <Panel MaxWidth="320">
                                                <TextBlock TextWrapping="Wrap" IsVisible="{Binding IsOverFull}"
                                                           Text="{m:LocFormat Key=Inventories_FillOverFullHelp, Path=TotalItemCount, Path2=Size}" />
                                                <TextBlock TextWrapping="Wrap" IsVisible="{Binding IsNearLoadLimit}"
                                                           Text="{m:LocFormat Key=Inventories_FillNearLoadLimitHelp, Path=TotalItemCount}" />
                                            </Panel>
                                        </ToolTip.Tip>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Width="12" Height="12" Data="{StaticResource OverFullGlyph}"
                                                      IsVisible="{Binding IsOverFull}"
                                                      AutomationProperties.AccessibilityView="Raw" />
                                            <PathIcon Width="12" Height="12" Data="{StaticResource NearLoadLimitGlyph}"
                                                      IsVisible="{Binding IsNearLoadLimit}"
                                                      AutomationProperties.AccessibilityView="Raw" />
                                            <TextBlock Text="{Binding CapacityLabel}" FontSize="12" FontWeight="Bold"
                                                       AutomationProperties.Name="{m:LocFormat Key=Inventories_CapacityA11y, Path=CapacityLabel}" />
                                            <!-- The word is what a screen reader hears; HelpText carries the tooltip's
                                                 explanation, which a mouse-less user can't hover for. -->
                                            <TextBlock Text="{m:Loc Inventories_FillOverFull}" FontSize="12" FontWeight="Bold"
                                                       IsVisible="{Binding IsOverFull}"
                                                       AutomationProperties.HelpText="{m:LocFormat Key=Inventories_FillOverFullHelp, Path=TotalItemCount, Path2=Size}" />
                                            <TextBlock Text="{m:Loc Inventories_FillNearLoadLimit}" FontSize="12" FontWeight="Bold"
                                                       IsVisible="{Binding IsNearLoadLimit}"
                                                       AutomationProperties.HelpText="{m:LocFormat Key=Inventories_FillNearLoadLimitHelp, Path=TotalItemCount}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Classes="divider" IsVisible="{Binding IsLogisticsContainer}" />

                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsLogisticsContainer}">
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Classes="caption"
                                               Text="{Binding LogisticsSummary}" />
                                    <Button Grid.Column="1" Content="{m:Loc Inventories_EditLogistics}"
                                            Command="{Binding DataContext.EditLogisticsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{m:LocFormat Key=Inventories_EditLogisticsA11y, Path=Label}" />
                                </Grid>

                                <Border Classes="divider" />

                                <TextBlock Text="{m:Loc Inventories_Empty}" Classes="caption"
                                           IsVisible="{Binding !HasItems}" />

                                <!-- A search matched only some of this inventory's items, so the card
                                     lists just those; say so, or it reads as if that is all it holds. -->
                                <TextBlock Classes="caption" IsVisible="{Binding IsNarrowed}"
                                           Text="{m:LocFormat Key=Inventories_ShowingSome, Path=Items.Count, Path2=TotalItemCount}" />

                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:InventoryItemView">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="0,3"
                                                  ToolTip.Tip="{Binding GId}">
                                                <Image Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center"
                                                       Source="{Binding IconFile, Converter={StaticResource Icon}}"
                                                       AutomationProperties.AccessibilityView="Raw" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                           Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                <!-- The item's world-object id (issue #3). Hidden from screen
                                                     readers here because the Move button's name carries it. -->
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="caption"
                                                           Text="{m:LocFormat Key=Inventories_ItemId, Path=WorldObjectId}"
                                                           AutomationProperties.AccessibilityView="Raw" />
                                                <Button Grid.Column="3" Content="{m:Loc Inventories_Move}"
                                                        Command="{Binding DataContext.MoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{m:LocFormat Key=Inventories_MoveA11y, Path=DisplayName, Path2=WorldObjectId}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="360"
                    IsVisible="{Binding IsLoaded, Converter={StaticResource InvertedBool}}">
            <TextBlock Text="{m:Loc Common_NoFileLoadedGoOpen}" TextAlignment="Center" HorizontalAlignment="Center" />
            <Button Classes="accent" HorizontalAlignment="Center"
                    Content="{m:Loc Common_OpenSaveFile}" Command="{Binding OpenFileCommand}" />
        </StackPanel>
    </Panel>

</UserControl>
