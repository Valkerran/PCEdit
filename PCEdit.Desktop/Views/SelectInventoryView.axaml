<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PCEdit.App.Core.ViewModels;assembly=PCEdit.App.Core"
             xmlns:models="clr-namespace:PCEdit.App.Core.Models;assembly=PCEdit.App.Core"
             xmlns:m="using:PCEdit.Desktop.Markup"
             xmlns:conv="using:PCEdit.Desktop.Converters"
             x:Class="PCEdit.Desktop.Views.SelectInventoryView"
             x:DataType="vm:SelectInventoryViewModel"
             x:Name="Root">

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="headingRule" />
                <TextBlock Text="{m:Loc SelectInv_Heading}" Classes="h2" VerticalAlignment="Center" />
            </StackPanel>
            <TextBox Text="{Binding Query, Mode=TwoWay}" PlaceholderText="{m:Loc SelectInv_Search}" />
            <!-- Moving part of a stack (issue #64): only shown when there is more than one item.
                 Destinations without room for the chosen quantity are disabled below. -->
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsStack}">
                <TextBlock Text="{m:Loc SelectInv_Quantity}" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding Quantity, Mode=TwoWay}" Minimum="1" Maximum="{Binding MaxQuantity}"
                               Increment="1" FormatString="0" ParsingNumberStyle="Integer" MinWidth="140"
                               AutomationProperties.Name="{m:LocFormat Key=SelectInv_QuantityA11y, Path=MaxQuantity}" />
                <TextBlock Text="{Binding MaxQuantity, StringFormat='/ {0}'}" VerticalAlignment="Center" Classes="caption"
                           AutomationProperties.AccessibilityView="Raw" />
                <Button Content="{m:Loc SelectInv_All}" Command="{Binding AllCommand}"
                        AutomationProperties.Name="{m:LocFormat Key=SelectInv_AllA11y, Path=MaxQuantity}" />
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmpty}}"
                       Classes="status"
                       Classes.success="{Binding StatusKind, Converter={StaticResource StatusIsSuccess}}"
                       Classes.error="{Binding StatusKind, Converter={StaticResource StatusIsError}}" />
            <Button HorizontalAlignment="Left" Content="{m:Loc Common_Cancel}" Command="{Binding CancelCommand}" />
        </StackPanel>

        <ScrollViewer>
            <StackPanel Spacing="8">
                <TextBlock Text="{m:Loc SelectInv_None}" Classes="caption" HorizontalAlignment="Center"
                           IsVisible="{Binding HasNoDestinations}" />
                <ItemsControl ItemsSource="{Binding FilteredOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:InventoryOptionView">
                            <Button Classes="link" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                    IsEnabled="{Binding HasRoom}"
                                    Command="{Binding #Root.DataContext.SelectCommand}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding AccessibleLabel}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Label}" />
                                        <!-- The inventory id (issue #3), as on the Inventories page:
                                             destinations with the same name are otherwise identical. -->
                                        <TextBlock Classes="caption"
                                                   Text="{m:LocFormat Key=Inv_Fallback, Path=InventoryId}"
                                                   IsVisible="{Binding ShowInventoryIdCaption}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CapacityLabel}" Classes="caption"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</UserControl>
